# Environment Configuration
# Kopiere diese Datei zu .env und passe die Werte an

# Server Configuration
NODE_ENV=production
PORT=3001

# Cloudflare Tunnel (optional - wird durch setup-cloudflare-tunnel.sh konfiguriert)
# TUNNEL_DOMAIN=dnd.deine-domain.de

# Session Secret (für Cookies)
# SESSION_SECRET=dein-geheimer-schlüssel-hier

# Weitere Optionen für zukünftige Features
# MAX_PLAYERS=10
# ENABLE_18PLUS=true
# LOG_LEVEL=info
